{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/web/index.html"
    },
    {
      "source": "/measure",
      "destination": "/web/modules/measure/index.html"
    },
    {
      "source": "/measure/index.html",
      "destination": "/web/modules/measure/index.html"
    },
    {
      "source": "/generate",
      "destination": "/web/modules/generate/index.html"
    },
    {
      "source": "/generate/index.html",
      "destination": "/web/modules/generate/index.html"
    }
  ],
  "headers": [
    {
      "source": "/web/modules/generate/assets/models/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
